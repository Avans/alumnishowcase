# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable (anon) key. Safe for the browser; Row Level Security protects the data.
SUPABASE_KEY=
# Server-only key used by /api/submissions to store submissions. Never expose it.
# Use either the new secret key ...
SUPABASE_SECRET_KEY=
# ... or the legacy service_role key.
SUPABASE_SERVICE_KEY=
# Optional: address shown on the site and used for intro requests.
NUXT_PUBLIC_ADMIN_CONTACT_EMAIL=s.vandockum@avans.nl
